{
  "hosting": {
    "public": "out",
    "target": "marketing-prod",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/privacy-policy/privacy-policy",
        "destination": "/privacy-policy",
        "type": 301
      }
    ],
    "headers": [
      { "source" : "**", "headers": [{"key": "Cache-Control", "value": "max-age=31536000"}] }
    ]
  }
}
